{
  "description": "Nhật ký AI 3 tầng (doc/AI-JOURNAL.md): ghi mọi thao tác của Codex vào .ai-journal/ (không commit). Codex chỉ nạp file này khi repo đã được trust.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/ai-journal.mjs capture codex", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/ai-journal.mjs capture codex", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$|^mcp__",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/ai-journal.mjs capture codex", "timeout": 15 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/ai-journal.mjs capture codex", "timeout": 15 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/ai-journal.mjs capture codex", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ai-journal.mjs stop codex",
            "timeout": 30,
            "statusMessage": "Kiểm tra nhật ký AI..."
          }
        ]
      }
    ]
  }
}
